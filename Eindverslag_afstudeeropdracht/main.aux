\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Het kernprincipe van het Extended Kalman Filter in één dimensie. De niet-lineaire functie $f(x)$ (blauw) wordt op elk tijdstip lokaal benaderd door een raaklyn (rood gestippeld) in het huidige schattingspunt $\hat  {x}_k$. De helling van die raaklyn is gelijk aan de afgeleide $f'(\hat  {x}_k)$. Het standaard Kalman Filter veronderstelt dat het systeem altijd globaal lineair is; het EKF herberekent deze lokale benadering bij elke tijdstap opnieuw \blx@tocontentsinit {0}\cite {bar_shalom_estimation}.}}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ekf_linearisatie}{{8}{17}{Het kernprincipe van het Extended Kalman Filter in één dimensie. De niet-lineaire functie $f(x)$ (blauw) wordt op elk tijdstip lokaal benaderd door een raaklyn (rood gestippeld) in het huidige schattingspunt $\hat {x}_k$. De helling van die raaklyn is gelijk aan de afgeleide $f'(\hat {x}_k)$. Het standaard Kalman Filter veronderstelt dat het systeem altijd globaal lineair is; het EKF herberekent deze lokale benadering bij elke tijdstap opnieuw \cite {bar_shalom_estimation}}{figure.caption.13}{}}
\newlabel{eq:jacobiaan}{{3}{17}{Extended Kalman Filter (EKF)}{equation.3}{}}
